#!/usr/bin/env bash
set -Eeuo pipefail

LOG=${CURL_LOG:?CURL_LOG is required}
log_args=("$0")
args=("$@")
index=0
while [[ $index -lt ${#args[@]} ]]; do
  arg=${args[$index]}
  if [[ "$arg" == "--header" && $((index + 1)) -lt ${#args[@]} && "${args[$((index + 1))]}" == Authorization:* ]]; then
    log_args+=("--header" "Authorization: REDACTED")
    index=$((index + 2))
  else
    log_args+=("$arg")
    index=$((index + 1))
  fi
done
printf '%q ' "${log_args[@]}" >>"$LOG"
printf '\n' >>"$LOG"

output=
method=GET
url=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      output=$2
      shift 2
      ;;
    --request)
      method=$2
      shift 2
      ;;
    --upload-file)
      shift 2
      ;;
    --data-binary)
      shift 2
      ;;
    --header)
      shift 2
      ;;
    --fail | --silent | --show-error)
      shift
      ;;
    *)
      url=$1
      shift
      ;;
  esac
done

case "$method:$url" in
  GET:*'/api/v1/buildbox/build-specs/101?run_id=401')
    cp "$FIXTURE_DIR/build-spec-apk.json" "$output"
    ;;
  GET:*'/api/v1/buildbox/build-specs/102?run_id=402')
    cp "$FIXTURE_DIR/build-spec-aab.json" "$output"
    ;;
  GET:*'/api/v1/buildbox/build-specs/103?run_id=403')
    jq '.id = "103" | .runId = "403" | .specHash = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"' \
      "$FIXTURE_DIR/build-spec-apk.json" >"$output"
    ;;
  PUT:https://oss.example/*)
    ;;
  POST:*'/api/v1/buildbox/runs/'*'/callback')
    ;;
  *)
    printf 'unexpected curl call: %s %s\n' "$method" "$url" >&2
    exit 1
    ;;
esac
