#!/usr/bin/env bash
set -Eeuo pipefail

LOG=${FLUTTER_LOG:?FLUTTER_LOG is required}
printf 'SWAN_ANDROID_APPLICATION_ID=%q SWAN_APP_DISPLAY_NAME=%q SWAN_ARTIFACT_KIND=%q ' \
  "${SWAN_ANDROID_APPLICATION_ID:-}" "${SWAN_APP_DISPLAY_NAME:-}" "${SWAN_ARTIFACT_KIND:-}" \
  >>"$LOG"
if [[ -f android/app/src/release/AndroidManifest.xml ]]; then
  tr '\n' ' ' <android/app/src/release/AndroidManifest.xml >>"$LOG"
  printf ' ' >>"$LOG"
fi
printf '%q ' "$0" "$@" >>"$LOG"
printf '\n' >>"$LOG"

write_unsigned_zip() {
  local path=$1
  local payload=$2
  local kind=${FLUTTER_OUTPUT_KIND:-unsigned}
  python3 - "$path" "$payload" "$kind" <<'PY'
import sys
import zipfile

path, payload, kind = sys.argv[1:]
with zipfile.ZipFile(path, "w") as archive:
    archive.writestr("AndroidManifest.xml", payload)
    if kind == "debug":
        archive.writestr("META-INF/ANDROIDD.SF", "debug")
        archive.writestr("META-INF/ANDROIDD.RSA", "debug")
    elif kind == "signed":
        archive.writestr("META-INF/CERT.SF", "signed")
        archive.writestr("META-INF/CERT.RSA", "signed")
PY
}

if [[ "$1" == "build" && "$2" == "apk" ]]; then
  mkdir -p build/app/outputs/flutter-apk
  write_unsigned_zip build/app/outputs/flutter-apk/app-release.apk 'contract apk'
  exit 0
fi

if [[ "$1" == "build" && "$2" == "appbundle" ]]; then
  mkdir -p build/app/outputs/bundle/release
  write_unsigned_zip build/app/outputs/bundle/release/app-release.aab 'contract aab'
  exit 0
fi

printf 'unexpected flutter call\n' >&2
exit 1
