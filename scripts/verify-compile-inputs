#!/usr/bin/env bash
set -Eeuo pipefail
set +x
state=${BUILDBOX_STATE_DIR:?}
source_root=${BUILDBOX_SOURCE_ROOT:-${GITHUB_WORKSPACE:?}/aviary-source}
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# This is untrusted compile code, executed only on the credential-free runner.
[[ -z "${HAWK_STAGE_TOKEN+x}" && -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN+x}" ]] || { echo 'compile runner must not carry stage credentials' >&2; exit 1; }
actual=$("$script_dir/dart-tool" spec-identity "$state/spec.json")
expected=$(jq -er '.specHash' "$state/spec.json")
[[ "$actual" == "$expected" ]] || { echo 'Prepared Spec digest mismatch' >&2; exit 1; }
# Bootstrap application-source tools only on the isolated compile runner.
(cd "$source_root/waterfowl/tools/swan_build" && dart pub get --enforce-lockfile)
"$script_dir/dart-tool" verify-source-catalog "$state/spec.json" "$source_root"
jq -e '.config' "$state/spec.json" >"$state/native-config.json"
dart run "$source_root/waterfowl/tools/swan_build/bin/assemble.dart" --spec "$state/native-config.json" --checkout "$source_root" --flutter-executable "$(command -v flutter)"
expected=$("$script_dir/resolve-flutter-version" "$source_root" "$state/spec.json")
actual=$(flutter --version --machine | jq -er '.frameworkVersion')
[[ "$actual" == "$expected" ]] || { echo 'Flutter toolchain does not match frozen inputs' >&2; exit 1; }
[[ -f "$source_root/waterfowl/pubspec.lock" ]] || { echo 'Workspace lockfile is missing' >&2; exit 1; }
(cd "$source_root/waterfowl" && flutter pub get --enforce-lockfile)
(cd "$source_root/waterfowl/apps/swan" && dart run tool/build_brand_assets.dart "$state/spec.json" "$source_root")
