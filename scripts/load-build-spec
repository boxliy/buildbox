#!/usr/bin/env bash
set -Eeuo pipefail
set +x

usage() {
  printf 'usage: %s <platform_run_id|build_spec_id:run_id>\n' "${0##*/}" >&2
}

die() {
  printf 'load-build-spec: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/targets.sh
source "$SCRIPT_DIR/lib/targets.sh"

json_get_required() {
  local filter=$1
  local name=$2
  local value
  value=$(jq -er "$filter | select(type == \"string\" and length > 0)" "$SPEC_RESPONSE") || die "missing required spec field: $name"
  printf '%s' "$value"
}

[[ $# -eq 1 ]] || { usage; exit 64; }

DISPATCH_ID=$1
if [[ "$DISPATCH_ID" =~ ^([0-9]+):([0-9]+)$ ]]; then
  BUILD_SPEC_ID=${BASH_REMATCH[1]}
  EXPECTED_RUN_ID=${BASH_REMATCH[2]}
elif [[ "$DISPATCH_ID" =~ ^[0-9]+$ ]]; then
  EXPECTED_RUN_ID=$DISPATCH_ID
  BUILD_SPEC_ID=
else
  die 'dispatch id must be a platform run id or build_spec_id:run_id'
fi
[[ -n "${HAWK_BASE_URL:-}" ]] || die 'HAWK_BASE_URL is required'
[[ -n "${HAWK_STAGE_TOKEN:-}" ]] || die 'HAWK_STAGE_TOKEN is required'

require_command curl
require_command jq
require_command sha256sum

STATE_DIR=${BUILDBOX_STATE_DIR:-${RUNNER_TEMP:-/tmp}/buildbox}
mkdir -p "$STATE_DIR"

SPEC_RESPONSE="$STATE_DIR/spec-response.json"
SPEC_JSON="$STATE_DIR/spec.json"
SPEC_ENV="$STATE_DIR/spec.env"
TARGETS_JSON="$STATE_DIR/targets.json"
UPLOADS_JSON="$STATE_DIR/uploads.json"
DART_DEFINES_JSON="$STATE_DIR/dart-defines.json"
SWAN_CONFIG_JSON="$STATE_DIR/swan-config.json"

BASE_URL=${HAWK_BASE_URL%/}
if [[ -n "$BUILD_SPEC_ID" ]]; then
  SPEC_URL="$BASE_URL/api/v1/buildbox/build-specs/$BUILD_SPEC_ID?run_id=$EXPECTED_RUN_ID"
else
  SPEC_URL="$BASE_URL/api/v1/buildbox/runs/$EXPECTED_RUN_ID/spec"
fi

curl --fail --silent --show-error \
  --header "Authorization: Bearer $HAWK_STAGE_TOKEN" \
  --header 'Accept: application/json' \
  --output "$SPEC_RESPONSE" \
  "$SPEC_URL"

REPOSITORY=$(json_get_required '.sourceRepo // .config.sourceRepo' sourceRepo)
COMMIT_SHA=$(json_get_required '.commitSha // .config.commitSha' commitSha)
RUN_ID=$(json_get_required '.runId' runId)
[[ "$RUN_ID" == "$EXPECTED_RUN_ID" ]] || die 'build spec response does not match dispatch run'
SPEC_HASH=$(json_get_required '.specHash' specHash)
ARTIFACT_PREFIX=$(json_get_required '.artifactPrefix' artifactPrefix)
ANDROID_APPLICATION_ID=$(json_get_required '.config.androidApplicationId' config.androidApplicationId)
APP_DISPLAY_NAME=$(json_get_required '.config.appDisplayName' config.appDisplayName)
[[ "$ANDROID_APPLICATION_ID" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]] || die 'androidApplicationId is invalid'

CONFIG_COMPACT=$(jq -ceS '.config | objects' "$SPEC_RESPONSE") || die 'config must be an object'
ACTUAL_SPEC_HASH="sha256:$(printf '%s' "$CONFIG_COMPACT" | sha256sum | awk '{print $1}')"
[[ "$SPEC_HASH" == "$ACTUAL_SPEC_HASH" ]] || die 'specHash does not match config'

TARGETS_RAW=$(jq -cer '.targets // .config.targets' "$SPEC_RESPONSE") || die 'targets must be a JSON array'
TARGETS_COMPACT=$(printf '%s' "$TARGETS_RAW" | targets_canonicalize_json) \
  || die 'targets must contain 1-2 unique values from apk, aab, ipa (legacy android_apk/android_aab accepted)'

jq -e \
  --arg repository "$REPOSITORY" \
  --arg commitSha "$COMMIT_SHA" \
  --arg artifactPrefix "$ARTIFACT_PREFIX" \
  --argjson targets "$TARGETS_COMPACT" \
  --argjson configTargets "$(jq -c '.config.targets' "$SPEC_RESPONSE")" '
  def canon($t):
    if $t == "android_apk" then "apk"
    elif $t == "android_aab" then "aab"
    else $t
    end;
  .config.sourceRepo == $repository and
  .config.commitSha == $commitSha and
  (.config.artifactPrefix as $base | $artifactPrefix | startswith($base)) and
  ($configTargets | map(canon(.))) == $targets
' \
  "$SPEC_RESPONSE" >/dev/null || die 'signed config does not match build spec fields'

# Prepare reads the frozen Spec only. Upload grants are a separate finalize request.
if jq -e 'has("uploads") and (.uploads | type == "array" and length > 0)' "$SPEC_RESPONSE" >/dev/null; then
  die 'prepare spec must not include upload authorization'
fi

if [[ ! "$COMMIT_SHA" =~ ^[0-9a-fA-F]{40}$ ]]; then
  die "commitSha must be a full 40-character SHA"
fi

CHECKOUT_REPOSITORY=$REPOSITORY
if [[ "$CHECKOUT_REPOSITORY" =~ ^https://github.com/([^/]+/[^/.]+)(\.git)?$ ]]; then
  CHECKOUT_REPOSITORY=${BASH_REMATCH[1]}
elif [[ "$CHECKOUT_REPOSITORY" =~ ^git@github.com:([^/]+/[^.]+)(\.git)?$ ]]; then
  CHECKOUT_REPOSITORY=${BASH_REMATCH[1]}
fi

if [[ ! "$CHECKOUT_REPOSITORY" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; then
  die "repository must be a GitHub owner/repo slug or github.com URL"
fi

printf '%s\n' "$TARGETS_COMPACT" | jq -e '.' >"$TARGETS_JSON"
printf '[]\n' | jq -e '.' >"$UPLOADS_JSON"

jq -e '
  {
    buildSpecId: $buildSpecId,
    sourceRepo: .sourceRepo,
    checkoutRepository: $checkoutRepository,
    commitSha: .commitSha,
    targets: $targets,
    runId: .runId,
    specHash: .specHash,
    config: .config,
    dartDefines: (.config.dartDefines // {}),
    swanConfig: (.config.swanConfig // {})
  }
' \
  --arg buildSpecId "$BUILD_SPEC_ID" \
  --arg checkoutRepository "$CHECKOUT_REPOSITORY" \
  --argjson targets "$TARGETS_COMPACT" \
  "$SPEC_RESPONSE" >"$SPEC_JSON"

jq -e '.dartDefines | objects' "$SPEC_JSON" >"$DART_DEFINES_JSON"
jq -e '.swanConfig | objects' "$SPEC_JSON" >"$SWAN_CONFIG_JSON"

TARGETS_CSV=$(jq -r 'join(",")' "$TARGETS_JSON")

{
  printf 'BUILDBOX_SPEC_ID=%q\n' "$BUILD_SPEC_ID"
  printf 'BUILDBOX_REPOSITORY=%q\n' "$REPOSITORY"
  printf 'BUILDBOX_CHECKOUT_REPOSITORY=%q\n' "$CHECKOUT_REPOSITORY"
  printf 'BUILDBOX_COMMIT_SHA=%q\n' "$COMMIT_SHA"
  printf 'BUILDBOX_TARGETS=%q\n' "$TARGETS_CSV"
  printf 'BUILDBOX_RUN_ID=%q\n' "$RUN_ID"
  printf 'BUILDBOX_SPEC_HASH=%q\n' "$SPEC_HASH"
  printf 'BUILDBOX_ANDROID_APPLICATION_ID=%q\n' "$ANDROID_APPLICATION_ID"
  printf 'BUILDBOX_APP_DISPLAY_NAME=%q\n' "$APP_DISPLAY_NAME"
  printf 'BUILDBOX_ARTIFACT_PREFIX=%q\n' "$ARTIFACT_PREFIX"
  printf 'BUILDBOX_SPEC_JSON=%q\n' "$SPEC_JSON"
  printf 'BUILDBOX_TARGETS_JSON=%q\n' "$TARGETS_JSON"
  printf 'BUILDBOX_UPLOADS_JSON=%q\n' "$UPLOADS_JSON"
  printf 'BUILDBOX_DART_DEFINES_JSON=%q\n' "$DART_DEFINES_JSON"
  printf 'BUILDBOX_SWAN_CONFIG_JSON=%q\n' "$SWAN_CONFIG_JSON"
} >"$SPEC_ENV"

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  {
    printf 'checkout_repository=%s\n' "$CHECKOUT_REPOSITORY"
    printf 'commit_sha=%s\n' "$COMMIT_SHA"
    printf 'targets=%s\n' "$TARGETS_CSV"
    printf 'run_id=%s\n' "$RUN_ID"
  } >>"$GITHUB_OUTPUT"
fi

printf 'Loaded build spec %s for run %s with targets %s\n' "$BUILD_SPEC_ID" "$RUN_ID" "$TARGETS_CSV"
