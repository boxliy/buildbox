#!/usr/bin/env bash
set -Eeuo pipefail
set +x

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/targets.sh
source "$SCRIPT_DIR/lib/targets.sh"
# shellcheck source=lib/artifact.sh
source "$SCRIPT_DIR/lib/artifact.sh"

die() {
  printf 'sign-android: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

STATE_DIR=${BUILDBOX_STATE_DIR:-${RUNNER_TEMP:-/tmp}/buildbox}
SPEC_ENV="$STATE_DIR/spec.env"
[[ -f "$SPEC_ENV" ]] || die "missing spec env: $SPEC_ENV"
# shellcheck disable=SC1090
source "$SPEC_ENV"
BUILDBOX_TARGETS_JSON=${BUILDBOX_TARGETS_JSON:-$STATE_DIR/targets.json}
[[ -f "$BUILDBOX_TARGETS_JSON" ]] || die "missing targets json: $BUILDBOX_TARGETS_JSON"

require_command jq
require_command python3

# Compile and sign runners must not receive upload authorization or the raw Hawk body.
for forbidden in uploads.json spec-response.json; do
  if [[ -e "$STATE_DIR/$forbidden" ]]; then
    die "refusing to sign while $forbidden is present in state"
  fi
done

if [[ -f "$STATE_DIR/spec.json" ]] && jq -e 'has("uploads") or (.. | objects | has("url"))' "$STATE_DIR/spec.json" >/dev/null; then
  die 'refusing to sign while spec.json contains upload urls'
fi

UNSIGNED_DIR="$STATE_DIR/unsigned"

sign_one() {
  local target=$1
  local basename
  local unsigned_path
  local state

  basename=$(target_artifact_basename "$target") || die "unsupported sign target: $target"
  unsigned_path="$UNSIGNED_DIR/$basename"
  [[ -f "$unsigned_path" ]] || die "unsigned artifact not found: $unsigned_path"

  case "$target" in
    apk | aab) ;;
    *) die "sign-android only supports apk and aab in phase A (got: $target)" ;;
  esac

  if ! state=$(artifact_signing_state "$unsigned_path"); then
    die "artifact is not a zip: $unsigned_path"
  fi
  case "$state" in
    unsigned) ;;
    debug) die "refusing debug-signed artifact for $target" ;;
    signed) die "refusing already-signed artifact for $target" ;;
    *) die "unrecognized signing state for $target: $state" ;;
  esac

  # No production signer ships in phase A. Missing or present material both
  # fail closed: never copy unsigned bytes forward and never exit 0.
  if [[ -z "${BUILDBOX_SIGNING_MATERIAL_DIR:-}" || ! -d "${BUILDBOX_SIGNING_MATERIAL_DIR}" ]]; then
    die "signing material is not configured; refusing unsigned $target"
  fi
  die "production signing is not implemented in phase A; refusing to report $target signed"
}

while IFS= read -r target; do
  sign_one "$target"
done < <(jq -r '.[]' "$BUILDBOX_TARGETS_JSON")
