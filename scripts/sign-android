#!/usr/bin/env bash
set -Eeuo pipefail
set +x

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/targets.sh
source "$SCRIPT_DIR/lib/targets.sh"

die() {
  printf 'sign-android: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

STATE_DIR=${BUILDBOX_STATE_DIR:-${RUNNER_TEMP:-/tmp}/buildbox}
SPEC_ENV="$STATE_DIR/spec.env"
[[ -f "$SPEC_ENV" ]] || die "missing spec env: $SPEC_ENV"
# shellcheck disable=SC1090
source "$SPEC_ENV"
BUILDBOX_TARGETS_JSON="$STATE_DIR/targets.json"
[[ -f "$BUILDBOX_TARGETS_JSON" ]] || die "missing targets json: $BUILDBOX_TARGETS_JSON"

require_command jq
require_command sha256sum
require_command wc
require_command cp

UNSIGNED_DIR="$STATE_DIR/unsigned"
ARTIFACT_DIR="$STATE_DIR/artifacts"
SIGN_PROOF_JSON="$STATE_DIR/sign-proof.json"
mkdir -p "$ARTIFACT_DIR"

sign_one() {
  local target=$1
  local basename
  local unsigned_path
  local signed_path
  local artifact_sha256
  local artifact_byte_size

  basename=$(target_artifact_basename "$target") || die "unsupported sign target: $target"
  unsigned_path="$UNSIGNED_DIR/$basename"
  signed_path="$ARTIFACT_DIR/$basename"
  [[ -f "$unsigned_path" ]] || die "unsigned artifact not found: $unsigned_path"

  case "$target" in
    apk | aab) ;;
    *) die "sign-android only supports apk and aab in phase A (got: $target)" ;;
  esac

  if [[ -n "${BUILDBOX_SIGNING_MATERIAL_DIR:-}" ]]; then
    die 'production signing material is not configured in phase A contract tests'
  fi

  cp "$unsigned_path" "$signed_path"

  artifact_sha256=$(sha256sum "$signed_path" | awk '{print $1}')
  artifact_byte_size=$(wc -c <"$signed_path" | tr -d '[:space:]')

  jq -n \
    --arg target "$target" \
    --arg path "$signed_path" \
    --arg fileName "$basename" \
    --arg sha256 "sha256:$artifact_sha256" \
    --argjson byteSize "$artifact_byte_size" \
    --arg mode "unsigned_release_stub" \
    '{target: $target, path: $path, fileName: $fileName, sha256: $sha256, byteSize: $byteSize, signMode: $mode}' \
    >"$ARTIFACT_DIR/$target.json"

  printf 'Signed (stub) %s (%s bytes)\n' "$signed_path" "$artifact_byte_size"
}

while IFS= read -r target; do
  sign_one "$target"
done < <(jq -r '.[]' "$BUILDBOX_TARGETS_JSON")

jq -s '.' "$ARTIFACT_DIR"/*.json >"$STATE_DIR/artifacts.json"

jq -n \
  --arg runId "$BUILDBOX_RUN_ID" \
  --arg specHash "$BUILDBOX_SPEC_HASH" \
  --argjson targets "$(cat "$BUILDBOX_TARGETS_JSON")" \
  --slurpfile artifacts "$STATE_DIR/artifacts.json" \
  '{
    runId: $runId,
    specHash: $specHash,
    targets: $targets,
    artifacts: $artifacts[0],
    signer: "buildbox-sign-android-stub-v1"
  }' >"$SIGN_PROOF_JSON"
