#!/usr/bin/env bash
set -Eeuo pipefail
set +x

usage() {
  printf 'usage: %s <running|succeeded|failed> [message]\n' "${0##*/}" >&2
  printf 'HAWK_CALLBACK_STAGE must be finalize\n' >&2
}

die() {
  printf 'report-result: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

[[ $# -ge 1 && $# -le 2 ]] || { usage; exit 64; }

STATUS=$1
MESSAGE=${2:-}
case "$STATUS" in
  running | succeeded | failed) ;;
  *) die "status must be running, succeeded, or failed" ;;
esac

[[ -n "${HAWK_BASE_URL:-}" ]] || die 'HAWK_BASE_URL is required'
[[ -n "${HAWK_STAGE_TOKEN:-}" ]] || die 'HAWK_STAGE_TOKEN is required'
# Hawk records a GitHub callback only for a finalize stage credential.
[[ "${HAWK_CALLBACK_STAGE:-}" == "finalize" ]] || die 'callback requires a finalize stage credential'
[[ -n "${BUILDBOX_GITHUB_RUN_ID:-}" ]] || die 'BUILDBOX_GITHUB_RUN_ID is required'
[[ "$BUILDBOX_GITHUB_RUN_ID" =~ ^[0-9]+$ ]] || die 'BUILDBOX_GITHUB_RUN_ID must be an integer'

require_command curl
require_command jq

STATE_DIR=${BUILDBOX_STATE_DIR:-${RUNNER_TEMP:-/tmp}/buildbox}
mkdir -p "$STATE_DIR"
SPEC_ENV="$STATE_DIR/spec.env"
# Failure and cancellation callbacks run before any job artifact exists.
# A missing spec env is valid for those statuses when the platform run id is already set.
if [[ -f "$SPEC_ENV" ]]; then
  # shellcheck disable=SC1090
  source "$SPEC_ENV"
fi
[[ -n "${BUILDBOX_RUN_ID:-}" ]] || die 'BUILDBOX_RUN_ID is required'
[[ "$BUILDBOX_RUN_ID" =~ ^[0-9]+$ ]] || die 'BUILDBOX_RUN_ID must be a platform run id'

BUILDBOX_ARTIFACTS_JSON="$STATE_DIR/artifacts.json"

PAYLOAD="$STATE_DIR/callback-${STATUS}.json"
BASE_URL=${HAWK_BASE_URL%/}
CALLBACK_URL="$BASE_URL/api/v1/buildbox/runs/$BUILDBOX_RUN_ID/callback"

if [[ "$STATUS" == "succeeded" ]]; then
  [[ -f "$SPEC_ENV" ]] || die "missing spec env: $SPEC_ENV"
  [[ -n "${BUILDBOX_ARTIFACT_PREFIX:-}" ]] || die 'BUILDBOX_ARTIFACT_PREFIX is required'
  [[ -n "${BUILDBOX_ARTIFACTS_JSON:-}" ]] || die 'missing artifacts metadata for success callback'
  jq -n \
    --arg status "$STATUS" \
    --argjson githubRunId "$BUILDBOX_GITHUB_RUN_ID" \
    --slurpfile artifacts "$BUILDBOX_ARTIFACTS_JSON" \
    --arg prefix "$BUILDBOX_ARTIFACT_PREFIX" \
    '{
      status: $status,
      githubRunId: $githubRunId,
      artifacts: (
        $artifacts[0] |
        map(
          . as $artifact |
          {
            target: $artifact.target,
            fileName: $artifact.fileName,
            contentType: (
              if $artifact.target == "apk" then "application/vnd.android.package-archive"
              else "application/octet-stream"
              end
            ),
            byteSize: $artifact.byteSize,
            sha256: $artifact.sha256,
            objectKey: ($prefix + $artifact.target + "." + (
              if $artifact.target == "apk" then "apk"
              elif $artifact.target == "aab" then "aab"
              else "ipa"
              end
            ))
          }
        )
      )
    }' >"$PAYLOAD"
elif [[ "$STATUS" == "failed" ]]; then
  jq -n \
    --arg status "$STATUS" \
    --argjson githubRunId "$BUILDBOX_GITHUB_RUN_ID" \
    --arg message "$MESSAGE" \
    '{
      status: $status,
      githubRunId: $githubRunId,
      artifacts: [],
      errorCode: "BUILD_FAILED",
      errorMessage: $message
    }' >"$PAYLOAD"
else
  jq -n \
    --arg status "$STATUS" \
    --argjson githubRunId "$BUILDBOX_GITHUB_RUN_ID" \
    '{status: $status, githubRunId: $githubRunId, artifacts: []}' >"$PAYLOAD"
fi

curl --fail --silent --show-error \
  --request POST \
  --header "Authorization: Bearer $HAWK_STAGE_TOKEN" \
  --header 'Content-Type: application/json' \
  --data-binary "@$PAYLOAD" \
  "$CALLBACK_URL"

printf 'Reported %s for run %s\n' "$STATUS" "$BUILDBOX_RUN_ID"
