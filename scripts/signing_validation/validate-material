#!/usr/bin/env bash
# Fetch one authorized material envelope and post the public validation result.
# The envelope and passwords stay in a mode-0600 file. They are not printed,
# uploaded, or passed as process arguments.
set -Eeuo pipefail
set +x

die() {
  printf 'validate-material: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

[[ -n "${HAWK_BASE_URL:-}" ]] || die 'HAWK_BASE_URL is required'
[[ "$HAWK_BASE_URL" == https://* ]] || die 'Hawk requires HTTPS'
[[ -n "${VALIDATION_ID:-}" ]] || die 'VALIDATION_ID is required'
[[ "$VALIDATION_ID" =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$ ]] || die 'VALIDATION_ID is invalid'
[[ -n "${HAWK_VALIDATION_TOKEN:-}" ]] || die 'validation credential is required'
[[ -n "${VALIDATOR_SHA:-}" ]] || die 'VALIDATOR_SHA is required'
[[ "$VALIDATOR_SHA" =~ ^[0-9a-f]{40}$ ]] || die 'VALIDATOR_SHA is invalid'

require_command curl
require_command jq
require_command python3

BASE_URL=${HAWK_BASE_URL%/}
umask 077
WORK=$(mktemp -d "${RUNNER_TEMP:-/tmp}/signing-validation.XXXXXX")
chmod 700 "$WORK"
ENVELOPE="$WORK/envelope.json"
OFFLINE="$WORK/offline.json"
RESULT="$WORK/result.json"
HAWK_RESULT="$WORK/hawk-result.json"
cleanup() {
  rm -f "$ENVELOPE" "$OFFLINE" "$RESULT" "$HAWK_RESULT"
  rmdir "$WORK" 2>/dev/null || true
}
trap cleanup EXIT

curl --fail --silent --show-error \
  --header "Authorization: Bearer $HAWK_VALIDATION_TOKEN" \
  --header 'Accept: application/json' \
  --output "$ENVELOPE" \
  "$BASE_URL/api/v1/buildbox/validations/$VALIDATION_ID/material"
chmod 600 "$ENVELOPE"

EVALUATED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
export EVALUATED_AT
python3 - "$ENVELOPE" "$OFFLINE" "$VALIDATOR_SHA" <<'PY'
import json, os, sys
from scripts.signing_validation.hawk_adapter import AdapterError, offline_request

source, destination, expected = sys.argv[1:]
document = json.loads(open(source, "rb").read())
if document.get("validationId") != os.environ["VALIDATION_ID"]:
    raise SystemExit("material validation id does not match the job")
if document.get("toolchainSha") != expected:
    raise SystemExit("material toolchain SHA does not match the checkout")
try:
    offline = offline_request(document, os.environ["EVALUATED_AT"])
except AdapterError as error:
    raise SystemExit(error.message) from error
open(destination, "w").write(json.dumps(offline))
PY
chmod 600 "$OFFLINE"

set +e
python3 -m scripts.signing_validation <"$OFFLINE" >"$RESULT"
status=$?
set -e
chmod 600 "$RESULT"
if [[ "$status" -ne 0 && "$status" -ne 2 ]]; then
  die "validator exited $status"
fi
python3 - "$ENVELOPE" "$RESULT" "$HAWK_RESULT" <<'PY'
import json, os, sys
from scripts.signing_validation.hawk_adapter import AdapterError, hawk_result

envelope = json.loads(open(sys.argv[1], "rb").read())
offline = json.loads(open(sys.argv[2], "rb").read())
try:
    body = hawk_result(envelope, offline, os.environ["EVALUATED_AT"])
except AdapterError as error:
    raise SystemExit(error.message) from error
open(sys.argv[3], "w").write(json.dumps(body, sort_keys=True))
PY
chmod 600 "$HAWK_RESULT"

curl --fail --silent --show-error \
  --request POST \
  --header "Authorization: Bearer $HAWK_VALIDATION_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Accept: application/json' \
  --data-binary @"$HAWK_RESULT" \
  --output /dev/null \
  "$BASE_URL/api/v1/buildbox/validations/$VALIDATION_ID/result"

python3 - "$HAWK_RESULT" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], "rb"))
print("validation status=%s reasons=%s" % (body.get("status"), ",".join(body.get("reasonCodes") or [])))
PY
if [[ "$status" -ne 0 ]]; then
  exit "$status"
fi
