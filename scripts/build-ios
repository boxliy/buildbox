#!/usr/bin/env bash
set -Eeuo pipefail
set +x
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
state=${BUILDBOX_STATE_DIR:?}
source_root=${BUILDBOX_SOURCE_ROOT:-${GITHUB_WORKSPACE:?}/aviary-source}
[[ "$(uname -s)" == Darwin ]] || { echo 'iOS compilation requires macOS' >&2; exit 1; }
[[ -z "${HAWK_STAGE_TOKEN+x}" && -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN+x}" ]] || { echo 'compile runner must not carry stage credentials' >&2; exit 1; }
"$script_dir/verify-compile-inputs"
jq -e '.config.platform == "ios" and .config.targets == ["ipa"]' "$state/spec.json" >/dev/null
expected_xcode=$(jq -r '.config.frozenInputs.xcodeBuild // empty' "$state/spec.json")
if [[ -n "$expected_xcode" ]]; then
  actual_xcode=$(xcodebuild -version | awk '/Build version/ {print $3}')
  [[ "$actual_xcode" == "$expected_xcode" ]] || { echo 'Xcode build mismatch' >&2; exit 1; }
fi
version=$(jq -er '.config.frozenInputs.versionName' "$state/spec.json")
number=$(jq -er '.config.frozenInputs.buildNumber' "$state/spec.json")
identifier=$(jq -er '.config.applicationIdentifier' "$state/spec.json")
name=$(jq -er '.config.appDisplayName' "$state/spec.json")
"$script_dir/dart-tool" ios-identity "$state/identity.xcconfig" "$identifier" "$name"
export XCODE_XCCONFIG_FILE="$state/identity.xcconfig"
jq -e '.config.dartDefines' "$state/spec.json" >"$state/ios-dart-defines.json"
cd "$source_root/waterfowl/apps/swan"
"$script_dir/dart-tool" ios-configure "$state/spec.json" ios/Runner.xcodeproj
flutter build ios --release --no-codesign --no-pub --build-name="$version" --build-number="$number" "--dart-define-from-file=$state/ios-dart-defines.json"
mkdir -p "$state/unsigned"
"$script_dir/dart-tool" ios-package build/ios/iphoneos "$state/unsigned/swan-release.ipa" "$state/spec.json"
