#!/usr/bin/env bash
set -Eeuo pipefail
set +x
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
state=${BUILDBOX_STATE_DIR:?}
source_root=${BUILDBOX_SOURCE_ROOT:-${GITHUB_WORKSPACE:?}/aviary-source}
[[ "$(uname -s)" == Darwin ]] || { echo 'iOS compilation requires macOS' >&2; exit 1; }
[[ -z "${HAWK_STAGE_TOKEN+x}" && -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN+x}" ]] || { echo 'compile runner must not carry stage credentials' >&2; exit 1; }
"$script_dir/verify-compile-inputs"
jq -e '.config.platform == "ios" and .config.targets == ["ipa"]' "$state/spec.json" >/dev/null
# The operator-approved runner's Xcode build must match the immutable Spec.
expected_xcode=$(jq -er '.config.frozenInputs.xcodeBuild | select(type == "string" and length > 0)' "$state/spec.json")
actual_xcode=$(xcodebuild -version | awk '/Build version/ {print $3}')
[[ "$actual_xcode" == "$expected_xcode" ]] || { echo 'Xcode build mismatch' >&2; exit 1; }
version=$(jq -er '.config.frozenInputs.versionName' "$state/spec.json")
number=$(jq -er '.config.frozenInputs.buildNumber' "$state/spec.json")
identifier=$(jq -er '.config.applicationIdentifier' "$state/spec.json")
name=$(jq -er '.config.appDisplayName' "$state/spec.json")
[[ "$identifier" =~ ^[A-Za-z][A-Za-z0-9-]*(\.[A-Za-z][A-Za-z0-9-]*)+$ ]] || exit 1
# Xcode project build settings override process environment. Supply a dedicated
# xcconfig through XCODE_XCCONFIG_FILE so identity cannot fall back to Swan.
python3 - "$state/identity.xcconfig" "$identifier" "$name" <<'PYCFG'
import sys
from pathlib import Path
if any(c in sys.argv[3] for c in '\n\r\0'):
    raise SystemExit('invalid display name')
# Display names are written directly to the generated product's Info.plist below.
Path(sys.argv[1]).write_text('SWAN_IOS_BUNDLE_ID = ' + sys.argv[2] + '\n')
PYCFG
export XCODE_XCCONFIG_FILE="$state/identity.xcconfig"
jq -e '.config.dartDefines' "$state/spec.json" >"$state/ios-dart-defines.json"
cd "$source_root/waterfowl/apps/swan"
# Source build phases run only here, before any signing material is available.
python3 "$script_dir/configure_ios.py" "$state/spec.json" ios/Runner.xcodeproj
method=$(jq -er '.config.signing.distributionMethod | select(. == "development" or . == "ad-hoc" or . == "enterprise" or . == "app-store")' "$state/spec.json")
flutter build ipa --export-method="$method" --release --no-codesign --no-pub --build-name="$version" --build-number="$number" "--dart-define-from-file=$state/ios-dart-defines.json"
# Plist mutation is data-only and occurs before isolated signing.
python3 - "$name" "$state/spec.json" <<'PYNAME'
from pathlib import Path
import json, plistlib, re, sys
spec=json.loads(Path(sys.argv[2]).read_text())
profile=spec['config']['appProfile']
capabilities={item['key'] for item in profile.get('deviceCapabilities', [])}
locale=profile.get('defaultLocale')
purposes={item['key']: {p['locale']:p['description'] for p in item.get('purposes', [])} for item in profile.get('deviceCapabilities', [])}
usage={
 'camera.capture': ('NSCameraUsageDescription', 'camera'),
 'microphone.record': ('NSMicrophoneUsageDescription', 'microphone'),
 'location.foreground': ('NSLocationWhenInUseUsageDescription', 'location'),
 'location.background': ('NSLocationAlwaysAndWhenInUseUsageDescription', 'background location'),
 'photos.read': ('NSPhotoLibraryUsageDescription', 'photo library'),
 'photos.write': ('NSPhotoLibraryAddUsageDescription', 'photo library'),
 'biometrics.authenticate': ('NSFaceIDUsageDescription', 'biometric authentication'),
}
if not capabilities <= set(usage) | {'notifications.push', 'background.execution'}:
    raise SystemExit('unsupported iOS native capability')
for info in Path('build/ios/archive/Runner.xcarchive/Products/Applications').glob('*.app/Info.plist'):
    body=plistlib.loads(info.read_bytes());body['CFBundleDisplayName']=sys.argv[1]
    for capability, (key, purpose) in usage.items():
        if capability in capabilities:
            description=purposes.get(capability, {}).get(locale)
            if spec['config'].get('signing', {}).get('source') == 'tenant' and not description:
                raise SystemExit('missing frozen usage description')
            body[key] = description or sys.argv[1] + ' uses ' + purpose + ' for enabled app features.'
    if 'location.background' in capabilities:
        body['NSLocationWhenInUseUsageDescription'] = purposes.get('location.foreground', {}).get(locale) or purposes.get('location.background', {}).get(locale) or sys.argv[1] + ' uses location for enabled app features.'
    modes=[]
    if 'location.background' in capabilities: modes.append('location')
    if 'notifications.push' in capabilities: modes.append('remote-notification')
    if 'background.execution' in capabilities: modes.append('fetch')
    body['UIBackgroundModes']=modes
    info.write_bytes(plistlib.dumps(body))
    for localization in profile.get('localizations', []):
        language=localization['locale']
        if not re.fullmatch(r'[A-Za-z0-9-]+', language):
            raise SystemExit('invalid native localization')
        strings={'CFBundleDisplayName': localization['displayName']}
        for capability, (key, _) in usage.items():
            if capability in capabilities and purposes.get(capability, {}).get(language):
                strings[key]=purposes[capability][language]
        if 'location.background' in capabilities and purposes.get('location.background', {}).get(language):
            strings.setdefault('NSLocationWhenInUseUsageDescription', purposes['location.background'][language])
        directory=info.parent / (language + '.lproj')
        directory.mkdir(exist_ok=True)
        (directory / 'InfoPlist.strings').write_bytes(plistlib.dumps(strings))
PYNAME
mkdir -p "$state/unsigned"
python3 - "$state/unsigned/swan-release.ipa" <<'PY'
from pathlib import Path
import sys, zipfile
apps = list(Path('build/ios/archive/Runner.xcarchive/Products/Applications').glob('*.app'))
if len(apps) != 1:
    raise SystemExit('expected exactly one unsigned device app')
with zipfile.ZipFile(sys.argv[1], 'w', zipfile.ZIP_DEFLATED) as archive:
    for item in sorted(apps[0].rglob('*')):
        if item.is_symlink():
            raise SystemExit('symlinks are not supported in unsigned iOS transport')
        if item.is_file():
            archive.write(item, Path('Payload') / apps[0].name / item.relative_to(apps[0]))
PY
